<Dialog id="pipelineReportDialog" title="Pipeline Report" contentWidth="98%" contentHeight="98%" showHeader="true" resizable="true" draggable="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <content>
        <VBox fitContainer="true" class="sapUiContentPadding">
            <!-- SmartFilterBar -->
            <smartFilterBar:SmartFilterBar id="pipelineSmartFilterBar" entitySet="xNGRxCDS_PS_MASTER" persistencyKey="pipelineFilterKey" useDateRangeType="false" search="onPipelineSearch">
                <smartFilterBar:layoutData>
                    <FlexItemData shrinkFactor="0" />
                </smartFilterBar:layoutData>
                <smartFilterBar:controlConfiguration>
                    <smartFilterBar:ControlConfiguration key="Status">
                        <smartFilterBar:customControl>
                            <Select id="statusFilterControl">
                                <core:Item key="" text="All" />
                                <core:Item key="WIP" text="In Progress" />
                                <core:Item key="SUBMITTED" text="Submitted" />
                            </Select>
                        </smartFilterBar:customControl>
                    </smartFilterBar:ControlConfiguration>
                </smartFilterBar:controlConfiguration>
            </smartFilterBar:SmartFilterBar>

            <!-- SmartTable -->
            <smartTable:SmartTable id="pipelineSmartTable" entitySet="xNGRxCDS_PS_MASTER" smartFilterId="pipelineSmartFilterBar" tableType="ResponsiveTable" enableExport="true" beforeExport="onPipelineBeforeExport" useVariantManagement="false" useTablePersonalisation="true" header="Pipeline Opportunities" showRowCount="true" enableAutoBinding="false" requestAtLeastFields="CustomerName,OppTcv,Currency,Status,Probability,SolutionArea,Country_Text" initiallyVisibleFields="CustomerName,OppTcv,Currency,Status,Probability,SolutionArea,Country_Text" class="sapUiResponsive" initialise="onPipelineTableInitialize" beforeRebindTable="onBeforeRebindTable">
                <smartTable:layoutData>
                    <FlexItemData growFactor="1" baseSize="0%" />
                </smartTable:layoutData>
                <smartTable:customToolbar>
                    <OverflowToolbar id="pipelineCustomToolbar" design="Transparent">
                        <ToolbarSpacer />
                        <Button id="exportPipelineBtn" text="Download as Excel" icon="sap-icon://excel-attachment" press="onExportPipelineToExcel" type="Emphasized" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
            </smartTable:SmartTable>
        </VBox>
    </content>
    <buttons>
        <Button text="Close" press="onClosePipelineDialog" type="Default" />
    </buttons>
</Dialog>